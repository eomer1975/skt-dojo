{
  "name": "skt_dojo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run build:js && npm run styles",
    "build:js": "node scripts/build-js.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "styles": "sass src/styles/main.scss assets/styles/main.css",
    "styles:watch": "sass --watch src/styles/main.scss:assets/styles/main.css",
    "serve": "node server.js",
    "dev": "npm run build && npm run serve"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "sass": "^1.89.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "lit": "^3.3.2"
  }
}
